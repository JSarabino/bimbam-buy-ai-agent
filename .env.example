# ==========================================================
# BimBam Assistant - Plantilla de configuración
# Copie este archivo como .env y complete los valores privados.
# ==========================================================

# Aplicación
APP_NAME=BimBam Assistant
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Google Gemini
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEMPERATURE=0

# Documentos e índice vectorial
DOCUMENTS_PATH=data/documents
FAISS_INDEX_PATH=storage/faiss_index

# Fragmentación de documentos
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Recuperación de información
RETRIEVAL_K=4
RETRIEVAL_SCORE_THRESHOLD=0.30